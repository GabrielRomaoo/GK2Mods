<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offline check of the planning logic against recipes/orders exported from the game files.
       Not part of the mod. Arguments: recipes.json orders.txt [factory.txt] (see Program.cs)  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Directory.Build.props targets the game (net472 + game references); this project opts out. -->
    <ImportDirectoryBuildProps>false</ImportDirectoryBuildProps>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\FactoryPlanner\Core\*.cs" Link="Core\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
