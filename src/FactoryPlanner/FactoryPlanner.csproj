<Project Sdk="Microsoft.NET.Sdk">
  <!-- Planejamento da Fábrica: the Quadro de Planejamento turns the town's orders into a factory plan. -->
  <PropertyGroup>
    <AssemblyName>GK2FactoryPlanner</AssemblyName>
    <RootNamespace>GK2Mods.FactoryPlanner</RootNamespace>
    <Version>0.3.0</Version>
    <ModFolder>GK2FactoryPlanner</ModFolder>
    <ModId>gk2factoryplanner</ModId>
    <ModDisplayName>Planejamento da Fábrica</ModDisplayName>
  </PropertyGroup>
  <ItemGroup>
    <!-- Generated by tools/icons/make_planner_icons.py -->
    <EmbeddedResource Include="Icons\*.png" />
    <!-- Generated by tools/models/planner_models.py -->
    <EmbeddedResource Include="Models\*.json;Models\*.png" />
    <!-- The chest window: TextMeshPro titles, a ScrollRect per column. -->
    <Reference Include="Unity.TextMeshPro" HintPath="$(ManagedDir)\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(ManagedDir)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(ManagedDir)\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="Newtonsoft.Json" HintPath="$(ManagedDir)\Newtonsoft.Json.dll" Private="false" />
    <!-- Lab runs (Lab.cs): screenshots. -->
    <Reference Include="UnityEngine.ScreenCaptureModule" HintPath="$(ManagedDir)\UnityEngine.ScreenCaptureModule.dll" Private="false" />
  </ItemGroup>
</Project>
